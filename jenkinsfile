pipeline{
    agent any
    stages{
        stage('checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Format')
        {
            steps{
                sh 'terraform fmt -check'
            }
        }
        stage('Terraform init'){
            steps{
                sh 'terraform init'
            }
        }

        stage('Terraform validate'){
            steps{
                sh 'terrafrm validate'
            }
        }

        stage('Terraform plan'){
            steps{
                sh 'terraform plan'
            }
        }

    }

}